# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# CocoaPods <= 1.17.0 has an upstream project-generation bug when local pod
# paths traverse pnpm symlinks. The workaround is version-bounded and only
# falls back on the exact `pathname contains null byte` failure.
require_relative './cocoapods_pnpm_pathname_workaround'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'G88' do
  config = use_native_modules!

  # Firebase's Swift pods are integrated as static libraries in this RN setup.
  # Their Obj-C transitive dependencies need module maps so Swift can import them.
  # Keep this targeted instead of enabling use_modular_headers! globally, which
  # would change module semantics for the full React Native / MapLibre pod graph.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    $MLRN.post_install(installer)
  end
end
