# Copy to .env and fill in values.
# All settings have sane defaults for local Docker dev — only secrets need changing.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=g88
POSTGRES_PASSWORD=g88dev
POSTGRES_DB=g88
POSTGRES_PORT=5432

# Used by the backend. Render injects DATABASE_URL in production; locally we
# compose it from the vars above.
DATABASE_URL=postgres://g88:g88dev@localhost:5432/g88

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Dev placeholder — DO NOT use in production.
# Production requires >= 64 chars: openssl rand -hex 64
JWT_SECRET=dev-jwt-secret-change-in-production-not-for-prod
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production-not-for-prod

# First-party product analytics pseudonymization key. Leave empty to disable
# ingestion locally. Production/closed testing: generate independently from JWT
# secrets (for example: openssl rand -hex 32) and keep it stable across deploys.
ANALYTICS_HMAC_KEY=
# Product events are retained 90 days by default; accepted range is 30–365.
ANALYTICS_RETENTION_DAYS=90

# Comma-separated. localhost ≠ 127.0.0.1 for browsers.
# Admin Vite (apps/admin) binds to 127.0.0.1:5173 — both forms listed.
# http://10.0.2.2:3001 for Android emulator dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://10.0.2.2:3001,http://127.0.0.1:5173,http://localhost:5173

# Comma-separated user UUIDs allowed to call /api/v1/admin/* (AdminGuard).
# Register a normal account, copy users.id, paste here, restart API.
ADMIN_USER_IDS=

# Optional: used by scripts/approve-id-verification.mjs (login → decide).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# API_URL=http://127.0.0.1:3001/api/v1
# API_URL=https://g88-api.onrender.com/api/v1

# ── Observability ─────────────────────────────────────────────────────────────
# Backend DSN from your Sentry NestJS project. Leave empty to disable.
SENTRY_DSN=

# ── External (leave blank for local dev — features degrade gracefully) ────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Twilio Verify (SMS + optional email channel). Missing SID → Redis OTP fallback.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# Fixed OTP for local/dev (default 000000). Never enable ALLOW_* on public prod long-term.
# DEV_OTP_CODE=000000
# ALLOW_DEV_EMAIL_OTP=true
# ALLOW_DEV_PHONE_OTP=true
# Phone/email: if Twilio fails (trial unverified number, channel off), API stores OTP in
# Redis and logs the code. channel=dev in the response → mobile shows the fixed-code hint.
SENDGRID_API_KEY=
# Private S3 storage region. The current uploads bucket is in Stockholm.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=g88-uploads-dev
# Assist-only ID face match (DetectFaces + CompareFaces). Off unless true.
# Rekognition is deliberately independent from AWS_REGION/S3: verification images are
# sent as bytes, because Amazon Rekognition has no eu-north-1 endpoint and S3Object
# references would require the S3 bucket to be in the same region as Rekognition.
# Production: use a supported EU Rekognition region, currently eu-central-1 (Frankfurt).
AWS_REKOGNITION_REGION=eu-central-1
# IAM on the AWS principal used by the backend:
#   rekognition:DetectFaces, rekognition:CompareFaces (Resource "*")
# S3 permissions remain separate for private verification storage/read/delete.
REKOGNITION_ENABLED=false
GOOGLE_CLIENT_ID=g88-android-debug
